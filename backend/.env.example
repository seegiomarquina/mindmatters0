# MindMatters AI Backend Engine Configuration
PROJECT_NAME="MindMatters AI Backend Engine"
VERSION="2.0.0"

# Security
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Use SQLite for local development (default, zero-setup):
DATABASE_URL="sqlite:///./mindmatters.db"
# Or use PostgreSQL for production:
# DATABASE_URL="postgresql://user:password@localhost:5432/mindmatters"

# Storage
MAX_FILE_SIZE_BYTES=15728640
